{
  "name": "smena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Смена — обучающая игра про отладку. Vue + Node, мультиплеер, раунды, лобби, рейтинг.",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace client",
    "start": "node server/src/index.js",
    "serve": "npm run build && npm start"
  }
}
